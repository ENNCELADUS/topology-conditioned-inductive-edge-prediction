h=1.5;fontColor=#111111;fontSize=28;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;fontStyle=2" vertex="1" parent="1"><mxGeometry x="712" y="142" width="648" height="72" as="geometry"/></mxCell><mxCell id="7" value="Template compiler — no parameters&lt;br&gt;remove the queried {u,v} edge, then keep&lt;br&gt;≤ 8 closure and ≤ 8 bridge slots per side" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#111111;strokeWidth=1.5;fontColor=#111111;fontSize=26;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="712" y="246" width="648" height="126" as="geometry"/></mxCell><mxCell id="8" value="A* — the compiled&lt;br&gt;motif graph&lt;br&gt;L_slot target" style="rounded=1;arcSize=50;html=1;whiteSpace=wrap;fillColor=#F9D9D9;strokeColor=#111111;strokeWidth=1.5;fontColor=#111111;fontSize=26;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center;fontStyle=2" vertex="1" parent="1"><mxGeometry x="712" y="404" width="308" height="126" as="geometry"/></mxCell><mxCell id="9" value="Rᵀ — frozen copy&lt;br&gt;of Stage I (eval)&lt;br&gt;L_topo target" style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#F9D9D9;strokeColor=#111111;strokeWidth=1.5;fontColor=#111111;fontSize=26;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1050" y="404" width="310" height="126" as="geometry"/></mxCell><mxCell id="10" value=" " style="rounded=1;arcSize=4;html=1;whiteSpace=wrap;fillColor=#F4FAF6;strokeColor=#111111;strokeWidth=1.5;fontColor=#111111;fontSize=26;fontFamily=Helvetica, Arial, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="40" y="562" width="642" height="700" as="geometry"/></mxCell><mxCell id="11" value="Generator G — Stage II only" style="text;html=1;whiteSpace=wrap;labelBackgroundColor=none;fillColor=none;strokeColor=none;strokeWidth=0;fontColor=#21212