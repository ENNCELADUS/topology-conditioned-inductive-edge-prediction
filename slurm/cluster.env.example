CLUSTER_HOST=login.example-cluster.edu      # ssh alias or host
CLUSTER_USER=$USER
CLUSTER_ACCOUNT=account_name
CLUSTER_PARTITION=gpu
CLUSTER_GRES=gpu:1
CLUSTER_TIME_TRAIN=12:00:00
CLUSTER_TIME_SCORE=08:00:00
CLUSTER_REPO_DIR=/scratch/$USER/topology-conditioned-inductive-edge-prediction
CLUSTER_DATA_ROOT=/scratch/$USER/tciep-data   # contains benchmark_2025_neurips/ + features/
CLUSTER_SETUP=""                              # optional: e.g. "module load cuda/12.4"
